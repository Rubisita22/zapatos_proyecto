<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_zapatos_venta_list" model="ir.ui.view">
        <field name="name">zapatos.venta.list</field>
        <field name="model">zapatos.venta</field>
        <field name="arch" type="xml">
            <list string="Ventas de Zapatos">
                <field name="fecha_venta"/>
                <field name="cliente_id"/>
                <field name="zapato_id"/>
                <field name="cantidad"/>
                <field name="precio_unitario"/>
                <field name="total" sum="Total General"/>
            </list>
        </field>
    </record>

    <record id="view_zapatos_venta_form" model="ir.ui.view">
        <field name="name">zapatos.venta.form</field>
        <field name="model">zapatos.venta</field>
        <field name="arch" type="xml">
            <form string="Registro de Venta">
                <sheet>
                    <group>
                        <group>
                            <field name="cliente_id"/>
                            <field name="zapato_id"/>
                            <field name="fecha_venta"/>
                        </group>
                        <group>
                            <field name="cantidad"/>
                            <field name="precio_unitario"/>
                            <field name="total" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_zapatos_venta" model="ir.actions.act_window">
        <field name="name">Ventas de Zapatos</field>
        <field name="res_model">zapatos.venta</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_zapatos_venta_action" 
              name="Ventas de Calzado" 
              parent="zapatos.menu_zapatos_root" 
              action="action_zapatos_venta" 
              sequence="20"/>
</odoo>